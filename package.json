{
  "name": "angular-auth-workspace",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build_auth_lib": "ng build angular-auth-lib",
    "build_auth_lib_prod": "ng build angular-auth-lib --configuration production",
    "copy-license": "cp projects/angular-auth-lib/LICENSE dist/angular-auth-lib",
    "copy-readme": "cp README.md dist/angular-auth-lib",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "pack_auth_lib": "cd dist/angular-auth-lib && npm pack",
    "package_auth_lib": "npm run build_auth_lib && npm run copy-files && npm run pack_auth_lib",
    "package_auth_lib_prod": "npm run build_auth_lib_prod && npm run copy-files && npm run pack_auth_lib",
    "publish_auth_lib_prod": "npm run package_auth_lib_prod && npm publish dist/angular-auth-lib/"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@ngrx/store-devtools": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.0.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@latest"
  }
}
